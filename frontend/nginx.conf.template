# Шаблон: nginx-образ прогоняет его через envsubst при старте.
# ${PORT}             — порт, который слушает контейнер (Railway задаёт свой).
# ${BACKEND_SCHEME}   — http для внутренней сети, https для публичного домена.
# ${BACKEND_UPSTREAM} — хост:порт бэкенда (backend:8000 локально,
#                       rrtm-backend.railway.internal:8000 в Railway).
# ${NGINX_RESOLVER}   — DNS для ленивого резолва апстрима: nginx не падает,
#                       если бэкенд поднимется позже.
server {
    listen ${PORT};

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_RESOLVER};

    # nginx по умолчанию достраивает относительный Location до абсолютного,
    # подставляя свои схему и порт (http и 8080 за TLS-прокси Railway).
    # Оставляем Location относительным — браузер сам добавит https и хост.
    absolute_redirect off;
    port_in_redirect off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        set $api_upstream "${BACKEND_SCHEME}://${BACKEND_UPSTREAM}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;
        # Host оставляем внешний, иначе FastAPI строит редирект «/x» → «/x/»
        # на внутренний адрес, и браузер блокирует его как Mixed Content.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        # Абсолютный Location от бэкенда превращаем в путь с префиксом /api/.
        proxy_redirect ~^https?://[^/]+/(.*)$ /api/$1;
        client_max_body_size 25m;
    }

    location /ws/ {
        set $ws_upstream "${BACKEND_SCHEME}://${BACKEND_UPSTREAM}";
        proxy_pass $ws_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
